{
  "name": "patchpilot",
  "displayName": "PatchPilot",
  "description": "Evidence-Backed Autonomous Patch Generation and Hunk-Level Staging",
  "version": "0.1.0",
  "publisher": "madhura200227",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "patchpilot.checkConnection",
        "title": "PatchPilot: Check TrueForge Connection",
        "category": "PatchPilot"
      },
      {
        "command": "patchpilot.startSession",
        "title": "PatchPilot: Start Test Session",
        "category": "PatchPilot"
      },
      {
        "command": "patchpilot.sendTestMessage",
        "title": "PatchPilot: Send Test Message",
        "category": "PatchPilot"
      },
      {
        "command": "patchpilot.cancelTurn",
        "title": "PatchPilot: Cancel Active Turn",
        "category": "PatchPilot"
      },
      {
        "command": "patchpilot.showOutput",
        "title": "PatchPilot: Show Output",
        "category": "PatchPilot"
      },
      {
        "command": "patchpilot.setToken",
        "title": "PatchPilot: Set TrueForge Access Token",
        "category": "PatchPilot"
      },
      {
        "command": "patchpilot.clearToken",
        "title": "PatchPilot: Clear TrueForge Access Token",
        "category": "PatchPilot"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "PatchPilot TrueForge Configuration",
      "properties": {
        "patchpilot.trueforge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "TrueForge Server Base URL (e.g., http://localhost:8790)."
        },
        "patchpilot.trueforge.agentName": {
          "type": "string",
          "default": "",
          "description": "Target TrueForge Agent Name registered on the TrueForge server."
        },
        "patchpilot.trueforge.requestTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "description": "Timeout in seconds for TrueForge API requests."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit",
    "bundle:test": "esbuild src/test/unit/*.test.ts --bundle --platform=node --external:vscode --external:mocha --outdir=dist/test/unit && esbuild src/test/integration/*.test.ts --bundle --platform=node --external:vscode --external:mocha --outdir=dist/test/integration",
    "test:unit": "npm run compile && npm run bundle:test && mocha --require dist/test/setup.js \"dist/test/unit/*.test.js\"",
    "test:integration": "npm run compile && npm run bundle:test && mocha --require dist/test/setup.js --timeout 30000 \"dist/test/integration/*.test.js\"",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "0.185.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.4",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.28.2",
    "mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
